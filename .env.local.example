# yogico 공유 클러스터 (vercelData·imgCreate 등과 같은 클러스터, DB 만 분리)
MONGODB_URI=mongodb+srv://<user>:<password>@yogico.dmz6oro.mongodb.net/?appName=yogico
MONGODB_DB=cdapi

# 배송 기록 보관 기간(일). 출하일이 있는 건만 대상 — 미출고 건(재고소진 등)은 파일에 있는 동안 보존된다.
RETENTION_DAYS=60

# 로그인 비밀번호 — 매장·물류팀 공용. 비워두면 2026
APP_PASSWORD=2026
# 세션 쿠키 서명 키 (16자 이상 무작위). 없으면 로그인이 되지 않는다.
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
